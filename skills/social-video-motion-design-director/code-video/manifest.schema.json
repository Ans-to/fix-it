{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arena-director:vector-profile:1.0.0",
  "title": "Director vector profile v1",
  "description": "Finite 2D SVG reference profile. Semantic constraints in CONTRACT.md and validator also apply.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "purpose": {
      "enum": [
        "illustrative",
        "production"
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "CONFIRMED",
                "PROPOSED"
              ]
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "numerator",
            "denominator",
            "status",
            "provenance"
          ]
        },
        "duration_seconds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "CONFIRMED",
                "PROPOSED"
              ]
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "numerator",
            "denominator",
            "status",
            "provenance"
          ]
        },
        "total_frames": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "fps",
        "duration_seconds",
        "total_frames"
      ]
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "width",
        "height",
        "background"
      ]
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "scale",
        "anchor",
        "offset"
      ]
    },
    "asset_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "const": "font"
          },
          "uniqueItems": true
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "kind": {
                "const": "font"
              },
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_./-]+$",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "kind",
              "path",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "allowed",
        "assets"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "start",
          "end"
        ]
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "type": {
                "const": "rect"
              },
              "visible": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "space": {
                "enum": [
                  "world",
                  "screen"
                ]
              },
              "z": {
                "type": "integer"
              },
              "style": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "fill": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stroke": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stroke_width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "fill",
                  "stroke",
                  "stroke_width",
                  "opacity"
                ]
              },
              "animations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "property": {
                      "enum": [
                        "translate_x",
                        "translate_y",
                        "opacity"
                      ]
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "from": {
                      "type": "number"
                    },
                    "to": {
                      "type": "number"
                    },
                    "easing": {
                      "enum": [
                        "linear",
                        "smoothstep",
                        "step"
                      ]
                    }
                  },
                  "required": [
                    "property",
                    "start",
                    "end",
                    "from",
                    "to",
                    "easing"
                  ]
                }
              },
              "geometry": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "visible",
              "space",
              "z",
              "style",
              "animations",
              "geometry"
            ]
          },
