                    "type": "number",
                    "minimum": 0
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "fill",
                  "stroke",
                  "stroke_width",
                  "opacity"
                ]
              },
              "animations": {
                "type": "array",
