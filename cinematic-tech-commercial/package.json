{
  "name": "cinematic-tech-commercial",
  "version": "1.0.0",
  "private": true,
  "description": "Storyboard-first cinematic tech commercial.",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/player": "4.0.539",
    "@remotion/three": "4.0.539",
    "@types/three": "^0.186.0",
    "lucide-react": "^1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:audio": "tsc --outDir .audio-test-build --strict --skipLibCheck --jsx react-jsx --esModuleInterop --module commonjs --target es2020 --moduleResolution node src/audio/AudioTrack.tsx && node --test tests/audio-track.test.cjs",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "studio": "remotion studio src/index.ts --no-open",
    "test:mock": "tsc --outDir .mock-test-build --strict --skipLibCheck --module commonjs --target es2020 --moduleResolution node src/config/mockTimings.ts && node --test tests/mock-timings.test.cjs",
    "build:preview": "vite build",
    "test:aesthetic": "node --test tests/scene1-aesthetic.test.cjs"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
